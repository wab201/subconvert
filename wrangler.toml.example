name = "subconvert"
compatibility_date = "2024-09-01"
pages_build_output_dir = "public"

# KV namespace for storing conversion links
# Run `npx wrangler kv namespace create SUBCONVERT_KV` first, then paste the id below
[[kv_namespaces]]
binding = "SUBCONVERT_KV"
id = "REPLACE_WITH_YOUR_KV_ID"
# For local dev, wrangler auto-creates a local KV instance
